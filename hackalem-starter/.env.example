# Скопируй этот файл в .env (cp .env.example .env) и впиши свои значения.
# .env НЕ коммитить в git — он уже в .gitignore.

OPENAI_API_KEY=sk-...

# На хакатоне уточни у организаторов, какие модели доступны по выданным
# токенам, и поставь актуальное имя сюда — трогать код при этом не нужно.
OPENAI_MODEL=gpt-5
OPENAI_FALLBACK_MODEL=gpt-4.1

MAX_RETRIES=3
